# Crema settings. Copy to .env.local (never committed) and fill in. With MONGODB_URI and AUTH_SECRET blank, Crema
# runs in local mode: no accounts, and figures stay in the browser.

# MongoDB Atlas connection string, with the database name at the end (…mongodb.net/crema).
MONGODB_URI=
# Signs sessions and encrypts two-step login secrets. Generate one with: npx auth secret
AUTH_SECRET=

# Google sign-in (optional): an OAuth client from Google Cloud Console. Authorized redirect URI:
# <your site>/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account emails over SMTP. Without EMAIL_SERVER_HOST, development prints the emails to the terminal instead.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Crema <hello@your-domain.com>"

# The site's address for links in emails. Optional on Netlify, which provides it.
APP_URL=

# Upstash Redis REST (optional): log-in and sign-up limits shared by every server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
